---
import Base from "../layouts/Base.astro";
import SectionTitle from "../components/SectionTitle.astro";

const title = "ページが見つかりません";
const description = "お探しのページは存在しません。";
---

<Base
  title={title}
  description={description}
  canonicalPath="/404"
  robots="noindex,nofollow"
  mainCentered
>
  <section class="not-found section container-page">
    <SectionTitle label="404 NOT FOUND" heading={title} />
    <p class="text-center" data-reveal>
      お探しのページは存在しないか、移動された可能性があります。
    </p>
    <p class="not-found__action text-center" data-reveal>
      <a href="/" class="btn"><span>トップへ戻る</span></a>
    </p>
  </section>
</Base>

<style>
  .not-found {
    padding-top: calc(var(--section-padding) + 40px);
  }

  .not-found__action {
    margin-top: 2.5rem;
  }
</style>
