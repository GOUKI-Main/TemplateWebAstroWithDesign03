---
import { site } from "../content/site";
import BrandMark from "./BrandMark.astro";

// Fixed, transparent over the hero; frosted glass with a gold scroll-progress
// hairline once the page has scrolled (src/scripts/header.ts toggles
// .is-scrolled). The links live in the fullscreen menu, opened by MENU.
// Without JavaScript the button does nothing — the footer repeats every
// link, so nothing becomes unreachable.
---

<header class="header" data-header data-menu-background>
  <a
    href="/"
    class="header__logo tap-target"
    aria-label={`${site.name} トップへ`}
  >
    <BrandMark class="header__mark" />
  </a>
  <button
    type="button"
    class="header__menu-btn tap-target"
    data-menu-toggle
    aria-label="メニューを開く"
    aria-expanded="false"
    aria-controls="fullscreen-menu"
  >
    <span class="header__menu-text">MENU</span>
  </button>
  <span class="header__progress" data-scroll-progress aria-hidden="true"></span>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 32px;
    pointer-events: none;
    transition:
      background var(--transition-base),
      box-shadow var(--transition-base),
      padding var(--transition-base);
  }

  .header:global(.is-scrolled) {
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
    padding: 12px 32px;
    pointer-events: auto;
  }

  .header__logo,
  .header__menu-btn {
    pointer-events: auto;
  }

  /* 1px gold line showing how far down the page you are */
  .header__progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .header:global(.is-scrolled) .header__progress {
    opacity: 1;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header__logo :global(.header__mark) {
    --mark-size: 48px;
    --mark-font: 1.15rem;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    transition:
      width var(--transition-base),
      height var(--transition-base);
  }

  .header:global(.is-scrolled) .header__logo :global(.header__mark) {
    --mark-size: 40px;
  }

  .header__menu-btn {
    padding: 10px 22px;
    border: 1.5px solid var(--color-fg);
    border-radius: 24px;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    transition: all var(--transition-base);
  }

  .header__menu-btn:hover {
    background: var(--color-fg);
  }

  .header__menu-btn:hover .header__menu-text {
    color: var(--color-bg);
  }

  .header__menu-text {
    font-family: var(--font-display);
    font-size: 0.8rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--color-fg);
    transition: color var(--transition-base);
  }

  @media (max-width: 768px) {
    .header {
      padding: 14px 16px;
    }

    .header:global(.is-scrolled) {
      padding: 10px 16px;
    }

    .header__logo :global(.header__mark) {
      --mark-size: 40px;
      --mark-font: 1rem;
    }

    .header:global(.is-scrolled) .header__logo :global(.header__mark) {
      --mark-size: 36px;
    }

    .header__menu-btn {
      padding: 8px 16px;
    }

    .header__menu-text {
      font-size: 0.7rem;
    }
  }
</style>
