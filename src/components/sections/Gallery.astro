---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionTitle from "../SectionTitle.astro";

// Square photo grid (3 → 2 → 1 columns). Each tile opens like a mask on
// scroll and shows its category over a bottom gradient on hover — always on
// touch screens, which have no hover.
export type GalleryItem = {
  src: ImageMetadata;
  alt: string;
  /** Short Latin caption (e.g. "Nail Art"). */
  category?: string;
};

const {
  label = "GALLERY",
  heading,
  items,
} = Astro.props as {
  label?: string;
  heading: string;
  items: GalleryItem[];
};
---

<section class="gallery section" id="gallery" aria-labelledby="gallery-heading">
  <div class="container-page">
    <SectionTitle label={label} heading={heading} id="gallery-heading" />
  </div>

  <ul class="gallery__grid container-page">
    {
      items.map((item) => (
        <li class="gallery__item img-hover-zoom" data-reveal-mask>
          <div class="gallery__media" data-reveal-scale>
            <Image
              src={item.src}
              alt={item.alt}
              widths={[320, 480, 640]}
              sizes="(max-width: 480px) 100vw, (max-width: 768px) 50vw, 33vw"
              format="webp"
              quality={80}
              loading="lazy"
            />
          </div>
          {item.category && (
            <div class="gallery__overlay" aria-hidden="true">
              <span class="gallery__category">{item.category}</span>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: clamp(40px, 6vw, 60px);
  }

  .gallery__item {
    position: relative;
    aspect-ratio: 1;
  }

  /* The reveal's zoom goes on this wrapper, not the img, so it never fights
     the img's own hover transition. */
  .gallery__media {
    width: 100%;
    height: 100%;
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A gradient from the bottom rather than a flat tint: the caption stays
     legible without darkening the whole photo. */
  .gallery__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(30, 28, 25, 0.55) 0%,
      rgba(30, 28, 25, 0.1) 40%,
      rgba(30, 28, 25, 0) 70%
    );
    display: flex;
    align-items: flex-end;
    padding: 16px;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .gallery__item:hover .gallery__overlay {
    opacity: 1;
  }

  .gallery__category {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.92);
    text-transform: uppercase;
  }

  /* No hover on touch screens — the caption would never show otherwise */
  @media (hover: none) {
    .gallery__overlay {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .gallery__overlay {
      padding: 10px;
    }

    .gallery__category {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 480px) {
    .gallery__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .gallery__item {
      aspect-ratio: 4 / 3;
    }
  }
</style>
