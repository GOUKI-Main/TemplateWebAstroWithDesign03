---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site } from "../../content/site";

// First screen: the tagline, the Latin wordmark (split into letters and
// lifted in by src/scripts/hero.ts), the subtitle whose tracking opens up,
// then the photo wiping in from below with the two calls to action over it.
const { image, alt, actions } = Astro.props as {
  image: ImageMetadata;
  alt: string;
  /** Up to two buttons over the photo. */
  actions: { label: string; href: string }[];
};
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__top">
    <p class="hero__tagline" data-hero-tagline>{site.tagline}</p>
    <h1 class="hero__title" id="hero-title" data-hero-title>
      {site.brand.wordmark}
      {
        site.brand.wordmark !== site.name && (
          <span class="sr-only">（{site.name}）</span>
        )
      }
    </h1>
    {
      site.brand.subtitle && (
        <p class="hero__subtitle" data-hero-subtitle>
          {site.brand.subtitle}
        </p>
      )
    }
  </div>
  <div class="hero__visual" data-hero-visual>
    <Image
      src={image}
      alt={alt}
      class="hero__image"
      widths={[480, 640]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      data-hero-image
    />
  </div>
  <div class="hero__actions">
    {
      actions.map((action) => (
        <a href={action.href} class="btn btn-light" data-hero-action>
          <span>{action.label}</span>
        </a>
      ))
    }
  </div>
  <p class="hero__scroll" data-hero-scroll aria-hidden="true">
    ( SCROLL DOWN )
  </p>
</section>

<style>
  .hero {
    position: relative;
    /* dvh, not vh: on phones 100vh is measured as if the URL bar were
       hidden, which would push the buttons below the first screen. */
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
  }

  .hero__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(100px, 15vh, 160px) var(--container-padding)
      clamp(40px, 5vh, 60px);
    text-align: center;
  }

  .hero__tagline {
    font-family: var(--font-serif);
    font-size: clamp(0.75rem, 1.5vw, 0.95rem);
    letter-spacing: 0.2em;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 300;
    letter-spacing: 0.25em;
    line-height: 1;
    color: var(--color-fg);
    margin-bottom: 1rem;
  }

  .hero__subtitle {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 1.5vw, 1rem);
    /* Where the opening-up tracking lands. hero.ts reads this variable. */
    --subtitle-tracking: 0.5em;
    letter-spacing: var(--subtitle-tracking);
    color: var(--color-muted);
  }

  .hero__visual {
    flex: 1;
    position: relative;
    overflow: hidden;
    min-height: 300px;
  }

  /* Absolutely positioned so only .hero__visual decides the height. In flow,
     the srcset's density-corrected intrinsic size would become the height
     and stretch the hero far past one screen. */
  .hero__visual :global(.hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__actions {
    position: absolute;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 16px;
    z-index: 10;
  }

  .hero__actions .btn {
    min-width: 160px;
    text-align: center;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
  }

  .hero__scroll {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.6);
    z-index: 10;
    animation: scrollBounce 2s ease-in-out infinite;
  }

  @keyframes scrollBounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll {
      animation: none;
    }
  }

  /* --- Intro initial states (released by src/scripts/hero.ts) --- */
  :global(html.has-motion) .hero__tagline {
    opacity: 0;
    transform: translateY(12px);
  }

  :global(html.has-motion) .hero__title,
  :global(html.has-motion) .hero__scroll {
    opacity: 0;
  }

  :global(html.has-motion) .hero__subtitle {
    opacity: 0;
    letter-spacing: calc(var(--subtitle-tracking) * 0.55);
  }

  :global(html.has-motion) .hero__visual {
    clip-path: inset(100% 0 0 0);
  }

  :global(html.has-motion) .hero__actions .btn {
    opacity: 0;
    transform: translateY(16px);
  }

  @media (max-width: 768px) {
    .hero__top {
      padding: clamp(80px, 12vh, 120px) var(--container-padding)
        clamp(24px, 4vh, 40px);
    }

    .hero__title {
      font-size: clamp(2.5rem, 14vw, 4rem);
      letter-spacing: 0.15em;
    }

    .hero__tagline {
      font-size: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .hero__subtitle {
      font-size: 0.75rem;
      --subtitle-tracking: 0.3em;
    }

    .hero__actions {
      position: static;
      transform: none;
      flex-direction: row;
      justify-content: center;
      gap: 12px;
      padding: 24px var(--container-padding) 16px;
      background: var(--color-bg);
    }

    .hero__actions .btn {
      min-width: 130px;
      padding: 12px 24px;
      font-size: 0.8rem;
      background: transparent;
      backdrop-filter: none;
      border-color: var(--color-fg);
      color: var(--color-fg);
    }

    .hero__actions .btn::before {
      background: var(--color-fg);
    }

    .hero__actions .btn:hover {
      color: var(--color-bg);
    }

    .hero__scroll {
      position: static;
      transform: none;
      text-align: center;
      padding-bottom: 16px;
      color: var(--color-muted);
      animation: none;
    }

    .hero__visual {
      min-height: 250px;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: clamp(2rem, 12vw, 3rem);
    }

    .hero__actions .btn {
      min-width: 110px;
      padding: 10px 20px;
      font-size: 0.75rem;
    }
  }
</style>
