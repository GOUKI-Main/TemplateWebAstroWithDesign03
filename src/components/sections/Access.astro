---
import { site } from "../../content/site";
import { formatOpeningHours } from "../../lib/hours";
import SectionTitle from "../SectionTitle.astro";

// Visible NAP (Name / Address / Phone) for local businesses, read from
// site.business — the same single source that drives the LocalBusiness
// JSON-LD, so what the page says and what search engines are told always
// match. Renders nothing when site.business is unset. (§4 MEO)
const {
  label = "ACCESS",
  heading = "アクセス",
  cta,
} = Astro.props as {
  label?: string;
  heading?: string;
  /** Button under the details. Defaults to calling the shop. */
  cta?: { label: string; href: string };
};

const b = site.business;
const a = b?.address;
const postal = a?.postalCode ? `〒${a.postalCode}` : null;
const street = a
  ? `${a.addressRegion ?? ""}${a.addressLocality}${a.streetAddress}`
  : null;
// "+81-3-0000-0000" → "03-0000-0000" for display; tel: keeps the + form.
const telDisplay = b?.telephone?.replace(/^\+81-?/, "0");
const hours = b?.openingHours?.length ? formatOpeningHours(b.openingHours) : [];
const button =
  cta ??
  (b?.telephone
    ? { label: "お電話でのお問い合わせ", href: `tel:${b.telephone}` }
    : null);
---

{
  b && (
    <section
      class="access section"
      id="access"
      aria-labelledby="access-heading"
    >
      <div class="container-page">
        <SectionTitle label={label} heading={heading} id="access-heading" />

        <div class="access__content">
          <div class="access__info" data-reveal-group>
            <div class="access__detail" data-reveal-item>
              <p class="access__salon-name">{site.brand.wordmark}</p>
              <p class="access__salon-subtitle">{b.legalName ?? site.name}</p>
            </div>

            <dl class="access__list">
              {street && (
                <div class="access__item" data-reveal-item>
                  <dt>住所</dt>
                  <dd>
                    {postal}
                    {postal && <br />}
                    {street}
                  </dd>
                </div>
              )}
              {b.notes?.map((note) => (
                <div class="access__item" data-reveal-item>
                  <dt>{note.label}</dt>
                  <dd>{note.value}</dd>
                </div>
              ))}
              {hours.length > 0 && (
                <div class="access__item" data-reveal-item>
                  <dt>営業時間</dt>
                  <dd>
                    {hours.map((line, i) => (
                      <>
                        {line}
                        {i < hours.length - 1 && <br />}
                      </>
                    ))}
                  </dd>
                </div>
              )}
              {b.telephone && (
                <div class="access__item" data-reveal-item>
                  <dt>電話番号</dt>
                  <dd>
                    <a href={`tel:${b.telephone}`}>{telDisplay}</a>
                  </dd>
                </div>
              )}
              {b.hasMap && (
                <div class="access__item" data-reveal-item>
                  <dt>地図</dt>
                  <dd>
                    <a href={b.hasMap} target="_blank" rel="noopener">
                      Google マップで見る
                    </a>
                  </dd>
                </div>
              )}
            </dl>

            {button && (
              <div class="access__cta" data-reveal-item>
                <a href={button.href} class="btn">
                  <span>{button.label}</span>
                </a>
              </div>
            )}
          </div>

          <div class="access__map" data-reveal-mask>
            {b.mapEmbedUrl ? (
              <iframe
                class="access__map-frame"
                src={b.mapEmbedUrl}
                title={`${b.legalName ?? site.name}の地図`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              />
            ) : (
              <div class="access__map-placeholder">
                <span class="access__map-marker" aria-hidden="true" />
                <span class="font-en">MAP</span>
                <p>Google マップの埋め込みエリア</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .access__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    margin-top: clamp(40px, 6vw, 60px);
  }

  .access__salon-name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 300;
    letter-spacing: 0.15em;
    line-height: 1.4;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  .access__salon-subtitle {
    font-size: 0.8rem;
    color: var(--color-muted);
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
  }

  .access__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .access__item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    font-size: 0.9rem;
  }

  .access__item dt {
    color: var(--color-muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    padding-top: 2px;
  }

  .access__item dd {
    color: var(--color-fg);
    line-height: 1.8;
  }

  .access__item a {
    color: var(--color-accent);
  }

  .access__cta {
    margin-top: 2.5rem;
  }

  .access__map {
    min-height: 400px;
  }

  .access__map-frame {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 400px;
    border: 1px solid var(--color-accent-light);
  }

  /* Until a map is embedded: a faint grid in a gold frame, so the spot reads
     as designed rather than as an unfinished grey box. */
  .access__map-placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: var(--color-surface);
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-border) 35%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-border) 35%, transparent) 1px,
        transparent 1px
      );
    background-size: 40px 40px;
    border: 1px solid var(--color-accent-light);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--color-muted);
  }

  /* The same diamond as the logo mark */
  .access__map-marker {
    width: 14px;
    height: 14px;
    border: 1px solid var(--color-accent);
    background: var(--color-bg);
    transform: rotate(45deg);
    margin-bottom: 12px;
  }

  .access__map-placeholder .font-en {
    font-size: 1.5rem;
    letter-spacing: 0.3em;
    color: var(--color-fg);
  }

  .access__map-placeholder p {
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .access__content {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .access__salon-name {
      font-size: 1.6rem;
    }

    .access__item {
      grid-template-columns: 72px 1fr;
      gap: 8px;
      font-size: 0.85rem;
    }

    .access__item dt {
      font-size: 0.75rem;
    }

    .access__cta {
      text-align: center;
    }

    .access__map,
    .access__map-frame,
    .access__map-placeholder {
      min-height: 240px;
    }
  }

  @media (max-width: 480px) {
    .access__item {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
