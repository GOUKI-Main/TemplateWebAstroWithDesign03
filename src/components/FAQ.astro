---
import SectionTitle from "./SectionTitle.astro";

// Accessible FAQ using native <details>/<summary>: no JavaScript, keyboard
// operable, and searchable with the browser's find-in-page.
// NOTE: Google removed FAQ rich results (2026-05), so this is for user value
// and page understanding — not for a rich-result snippet. No FAQPage JSON-LD.
type QA = { q: string; a: string };
const {
  items,
  label = "FAQ",
  heading = "よくある質問",
} = Astro.props as {
  items: QA[];
  label?: string;
  heading?: string;
};
---

<section class="faq section" id="faq" aria-labelledby="faq-heading">
  <div class="faq__inner container-page">
    <SectionTitle label={label} heading={heading} id="faq-heading" />
    <div class="faq__list" data-reveal-group>
      {
        items.map((item) => (
          <details class="faq__item" data-reveal-item>
            <summary class="faq__question">
              <span class="faq__q" aria-hidden="true">
                Q
              </span>
              <span class="faq__question-text">{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <p class="faq__answer">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__inner {
    max-width: 800px;
  }

  .faq__list {
    margin-top: clamp(40px, 6vw, 60px);
    border-top: 1px solid var(--color-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__question {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 24px 4px;
    cursor: pointer;
    list-style: none;
    color: var(--color-fg);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .faq__question-text {
    flex: 1;
  }

  /* A thin plus that turns into a minus when open */
  .faq__icon {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    align-self: center;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: var(--color-muted);
    transition: transform var(--transition-base);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__answer {
    padding: 0 4px 24px calc(1.25rem + 20px);
    font-size: 0.9rem;
    line-height: 2;
    color: var(--color-body);
  }

  @media (max-width: 768px) {
    .faq__question {
      gap: 12px;
      padding: 18px 2px;
      font-size: 0.875rem;
    }

    .faq__answer {
      padding: 0 2px 18px calc(1.25rem + 14px);
      font-size: 0.85rem;
    }
  }
</style>
